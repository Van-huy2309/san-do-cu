@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam fontName Times New Roman
skinparam sequenceMessageAlign left
skinparam sequenceArrowColor black
skinparam sequenceLifeLineBorderColor black
title Biểu đồ tuần tự chức năng tìm và xem sản phẩm

actor "Người dùng" as User
boundary "Giao diện\nchợ" as UI
control "Hệ thống xử lý" as Sys
database "CSDL\ntin đăng" as DB

User -> UI : 1. Nhập từ khóa / bộ lọc
UI -> Sys : 2. Gửi yêu cầu tìm kiếm
Sys -> DB : 3. Truy vấn danh sách tin
DB --> Sys : 4. Trả danh sách về
Sys --> UI : 5. Hiển thị danh sách tin
User -> UI : 6. Chọn một tin
UI -> Sys : 7. Gửi yêu cầu xem chi tiết
Sys -> DB : 8. Truy vấn chi tiết tin
DB --> Sys : 9. Trả kết quả về
Sys --> UI : 10. Hiển thị tình trạng,\ngiá và nguồn gốc
@enduml
