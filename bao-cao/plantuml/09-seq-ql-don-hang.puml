@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam fontName Times New Roman
skinparam sequenceMessageAlign left
skinparam sequenceArrowColor black
skinparam sequenceLifeLineBorderColor black
title Biểu đồ tuần tự chức năng quản lý đơn hàng

actor "Admin" as User
boundary "Giao diện\nđơn hàng" as UI
control "Hệ thống xử lý" as Sys
database "CSDL\nđơn hàng" as DB

User -> UI : 1. Chọn đơn và\ntrạng thái mới
UI -> Sys : 2. Gửi yêu cầu cập nhật
Sys -> Sys : 3. Kiểm tra trạng thái hợp lệ
Sys -> DB : 4. Cập nhật đơn hàng
DB --> Sys : 5. Trả kết quả về
Sys --> UI : 6. Xác nhận đã lưu
UI --> User : 7. Hiển thị trạng thái đơn
@enduml
