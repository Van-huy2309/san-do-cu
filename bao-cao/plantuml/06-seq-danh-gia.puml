@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam fontName Times New Roman
skinparam sequenceMessageAlign left
skinparam sequenceArrowColor black
skinparam sequenceLifeLineBorderColor black
title Biểu đồ tuần tự chức năng đánh giá

actor "Người dùng" as User
boundary "Giao diện\nđánh giá" as UI
control "Hệ thống xử lý" as Sys
database "CSDL\nđánh giá" as DB

User -> UI : 1. Chọn số sao\nvà nhận xét
UI -> Sys : 2. Gửi yêu cầu đánh giá
Sys -> Sys : 3. Kiểm tra đã mua tin
Sys -> DB : 4. Lưu đánh giá
DB --> Sys : 5. Trả kết quả về
Sys --> UI : 6. Xác nhận đã lưu
UI --> User : 7. Hiển thị đánh giá
@enduml
