APP_NAME=Relic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=600
FAIL2BAN_BANTIME=900

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=relic_market
DB_USERNAME=root
DB_PASSWORD=

FINANCE_DB_HOST=127.0.0.1
FINANCE_DB_PORT=3306
FINANCE_DB_DATABASE=relic_finance
FINANCE_DB_USERNAME=
FINANCE_DB_PASSWORD=

# Để trống khi chạy XAMPP. Docker Compose tự điền để web gọi service ngân hàng.
FINANCE_API_URL=
FINANCE_API_KEY_ID=
FINANCE_API_SECRET=
FINANCE_API_SECRET_PREVIOUS=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"
SMS_DRIVER=log
ELASTICSEARCH_HOST=
# Relic Care LLM (auto = dùng Gemini nếu có key, không thì OpenAI, không có key = template cục bộ)
AI_LLM_ENABLED=true
AI_LLM_PROVIDER=auto
AI_LLM_TEMPERATURE=0.4
AI_LLM_MAX_TOKENS=400
AI_LLM_TIMEOUT=20
AI_LLM_HISTORY_TURNS=6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
REVERB_APP_ID=relic
REVERB_APP_KEY=relickey
REVERB_APP_SECRET=relicsecret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
